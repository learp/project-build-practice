<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    
    <modelVersion>4.0.0</modelVersion>

    <groupId>best.project</groupId>
    <artifactId>logstats</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>

        <maven.compiler.proc>full</maven.compiler.proc>

        <gson.version>2.10.1</gson.version>
        <slf4j.version>2.0.9</slf4j.version>
        <logback.version>1.4.14</logback.version>
        <lombok.version>1.18.48</lombok.version>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <!-- JSON-сериализация: нужна и при компиляции, и в рантайме - scope compile -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <!-- API логирования: наш код пишет через него - compile -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!--
          Имплементация логирования. Наш код её не использует (только slf4j-api),
          но она нужна при запуске - scope runtime. В classpath для компиляции
          её не будет, а при запуске будет. Транзитивно подтянет logback-core.
        -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!--
          Lombok: генерирует код НА ЭТАПЕ КОМПИЛЯЦИИ (@Slf4j создаёт поле log).
          В итоговый jar не попадает - scope provided.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
          «Коллега добавил для будущего HTTP-клиента». Работает? Работает.
          Только эта зависимость транзитивно тянет gson:2.8.5 - а у нас уже есть
          своя gson:2.10.1. Кто победит? Сборка не сломается, Maven решит молча.
          Смотрим: ./mvnw dependency:tree -Dverbose
        -->
        <dependency>
            <groupId>com.squareup.retrofit2</groupId>
            <artifactId>converter-gson</artifactId>
            <version>2.9.0</version>
        </dependency>

        <!-- Тесты: нужны только для mvn test, в jar не попадают - scope test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Surefire запускает тесты. Дефолтная версия в Maven древняя и
              JUnit 5 не знает, поэтому фиксируем современную.
              Остальные шаги (компиляция, jar) Maven делает дефолтными plugin'ами.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
            </plugin>
        </plugins>
    </build>
</project>
